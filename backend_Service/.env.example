PORT=5000
NODE_ENV=production

# Database (Supabase PostgreSQL or MySQL)
# For Supabase, get your URI from: Supabase Dashboard -> Project Settings -> Database -> Connection string (URI)
DATABASE_URL=postgresql://postgres.yourprojectref:yourpassword@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
# DB_URI=mysql://root:password@host:port/africanscholar

# Authentication
JWT_SECRET=your_production_jwt_secret_key_here

# Cloudinary (File and document uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Paystack (Payment integration)
PAYSTACK_SECRET_KEY=sk_live_or_test_key
PAYSTACK_PUBLIC_KEY=pk_live_or_test_key

# Client Origins for CORS and email links
USER_CLIENT_URL=https://your-user-portal.up.railway.app
ADMIN_CLIENT_URL=https://your-admin-portal.up.railway.app
ADMIN_SUBDOMAIN_URL=https://your-admin-portal.up.railway.app

# SMTP / Email configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_SECURE=tls
